{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "01 应用外壳/**/*",
    "02 界面渲染/**/*",
    "03 进程桥接/**/*",
    "04 模型接入/**/*",
    "07 设定档案/**/*",
    "10 书库检索/**/*",
    "11 文件工作区/**/*",
    "13 共享黑板/**/*",
    "14 配置密钥/**/*"
  ]
}
