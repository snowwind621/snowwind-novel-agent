{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "01 应用外壳/**/*",
    "02 界面渲染/**/*",
    "03 进程桥接/**/*",
    "04 模型接入/**/*",
    "05 编排内核/**/*",
    "06 智能体运行时/**/*",
    "07 设定档案/**/*",
    "09 台账同步/**/*",
    "10 书库检索/**/*",
    "11 文件工作区/**/*",
    "12 导出转换/**/*",
    "13 共享黑板/**/*",
    "14 配置密钥/**/*",
    "16 书库迁移/**/*",
    "17 建议审阅/**/*"
  ]
}
